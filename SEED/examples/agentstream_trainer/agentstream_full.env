# =============================================================================
# SEED x AgentStream 正式训练配置
# -----------------------------------------------------------------------------
# 被 Stage 1（hindsight-skill 数据构造）、Stage 2（SFT）、Stage 3（自进化 OPD RL）
# 共同 source。所有变量均为 ${VAR:-default} 写法，调用侧 export 即可覆盖。本文件不含
# 任何机器专属路径或密钥：代码路径按本文件位置自动推导，模型/checkpoint 根目录、
# GPU 与 API key 由 SEED/.env（不入库；可复制 SEED/.env.example）按机器覆盖。
#
# 目录
#   §0 全局共享     根路径 / wandb / benchmark 集合与外部服务 / 任务流规模 / 步数与观测预算
#   §1 底座模型     模型选择、派生 tag、thinking 开关、动作解析宽松度
#   §2 Stage 1/2    数据构造 + SFT 超参、本地策略 vLLM 端点
#   §3 Stage 3      stream profile、验证、优化与显存、checkpoint 与实验名
#   §4 SEED / OPD   单轨 + 双轨技能蒸馏旋钮、analysis 后端
#   §5 阶段开关     run_all.sh 的 prepare / sft / rl 开关
# =============================================================================


# =============================================================================
# §0 全局共享（Stage 1/2/3 共用）
# =============================================================================

# ---- 根路径（默认使用仓库内 LLMs/ 与 ckpt/，特殊布局由 .env 覆盖） --------------
# 代码侧：由本文件所在位置推导，仓库整体搬到哪里都不用改。
#   AGENTSTREAM_SEED_ROOT      <SEED>                 本仓库根（含 agent_system/ verl/ outputs/）
#   AGENTSTREAM_REPO_ROOT      <SEED>/..              SEED 与 AgentStream 的共同父目录
#   AGENTSTREAM_EXGENTIC_ROOT  <REPO>/AgentStream/exgentic
# 数据侧（目录不入库；已有的 .env 或 export 同名变量优先于以下默认值）：
#   AGENTSTREAM_LLMS_ROOT      <REPO>/LLMs            底座 / SFT 导出权重 / Embedding 模型
#   MODELS_ROOT                = LLMS_ROOT            SFT 中间权重在其 outputs/sft/，日志在 logs/sft/
#   CHECKPOINTS_ROOT           <REPO>/ckpt            仅 RL checkpoint（按实验名分目录）
#   AGENTSTREAM_TMP_ROOT       可选临时目录根；不设时尊重系统/作业调度器的 TMPDIR
_as_config_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AGENTSTREAM_SEED_ROOT=${AGENTSTREAM_SEED_ROOT:-$(cd "$_as_config_dir/../.." && pwd)}
AGENTSTREAM_REPO_ROOT=${AGENTSTREAM_REPO_ROOT:-$(cd "$AGENTSTREAM_SEED_ROOT/.." && pwd)}
AGENTSTREAM_EXGENTIC_ROOT=${AGENTSTREAM_EXGENTIC_ROOT:-$AGENTSTREAM_REPO_ROOT/AgentStream/exgentic}

AGENTSTREAM_LLMS_ROOT=${AGENTSTREAM_LLMS_ROOT:-${MODELS_ROOT:-$AGENTSTREAM_REPO_ROOT/LLMs}}
MODELS_ROOT=${MODELS_ROOT:-$AGENTSTREAM_LLMS_ROOT}
CHECKPOINTS_ROOT=${CHECKPOINTS_ROOT:-$AGENTSTREAM_REPO_ROOT/ckpt}

AGENTSTREAM_TMP_ROOT=${AGENTSTREAM_TMP_ROOT:-}
if [[ -n "$AGENTSTREAM_TMP_ROOT" ]]; then
	mkdir -p "$AGENTSTREAM_TMP_ROOT/ray"
	TMPDIR=${TMPDIR:-$AGENTSTREAM_TMP_ROOT}               # uv / pip 等临时解包（不迁移持久缓存）
	RAY_TMPDIR=${RAY_TMPDIR:-$AGENTSTREAM_TMP_ROOT/ray}     # Ray 临时根；不替代 /dev/shm
fi

# ---- wandb -------------------------------------------------------------------
# 默认 online；api.wandb.ai 不可达时在调用侧设 WANDB_MODE=offline，离线 run 落在
# 本地，之后可用 wandb sync 补传。
WANDB_MODE=${WANDB_MODE:-online}

# ---- benchmark 集合与外部服务 ------------------------------------------------
# 任务选择固定用 seed 42；AGENTSTREAM_STREAM_SEED（见下）只控制域内顺序与跨域交错。
# 已打通的 benchmark：bfcl / appworld / tau2（正式三件套）以及 hle / browsecompplus。
#   - 全量写法：bfcl,appworld,tau2,hle,browsecompplus
#   - hle 需要 HF_TOKEN（cais/hle 为 gated 数据集），放在 .env
#   - browsecompplus 依赖共享检索服务，由 Stage-3 运行脚本自动拉起（见下方
#     AGENTSTREAM_RETRIEVER_* 开关）
AGENTSTREAM_BENCHMARKS=${AGENTSTREAM_BENCHMARKS:-bfcl,tau2,browsecompplus}

# tau2 用户模拟器与 hle / browsecompplus 判分器共用的 API 模型（litellm 路由名）。
AGENTSTREAM_API_MODEL=${AGENTSTREAM_API_MODEL:-openrouter/z-ai/glm-5.2}

# browsecompplus 共享检索服务：所有 env worker 只发查询，索引与向量模型只加载一份。
#   - RETRIEVER_URL 为本机地址且 AUTO_START=1 时，训练前自动拉起
#     （ensure_browsecomp_retriever.sh）；远程地址只做健康检查；0 = 关闭自动拉起。
#   - RETRIEVER_DEVICE：检索服务跑在哪里。GPU 卡号（如 1）= 该卡上跑 fp16 编码器；
#     cpu = 纯 CPU，同一索引，编码器以 bf16 跑在 CPU（Sapphire Rapids 走 AMX），线程数 =
#     RETRIEVER_THREADS（默认本作业核数的一半，其余留给 env worker / vLLM 调度）；
#     并发查询会合并成一次前向（serve 脚本的 MAX_BATCH / BATCH_WINDOW_S）。
#     默认 cpu（两卡都归训练，不与 vLLM 共卡）；有空闲卡时在 .env 里改成卡号。
#   - 索引 + Qwen3-Embedding-8B 加载慢，启动等待上限 1200s。
#   - EMBED_MODEL_PATH：本地已下载到 $AGENTSTREAM_LLMS_ROOT/Qwen3-Embedding-8B 时直接用，
#     否则由 serve_browsecomp_retriever.sh 按 HF id 拉取。
AGENTSTREAM_BROWSECOMP_RETRIEVER_URL=${AGENTSTREAM_BROWSECOMP_RETRIEVER_URL:-http://127.0.0.1:60100}
AGENTSTREAM_RETRIEVER_AUTO_START=${AGENTSTREAM_RETRIEVER_AUTO_START:-1}
AGENTSTREAM_RETRIEVER_DEVICE=${AGENTSTREAM_RETRIEVER_DEVICE:-cpu}   # cpu | GPU 卡号
AGENTSTREAM_RETRIEVER_THREADS=${AGENTSTREAM_RETRIEVER_THREADS:-$(( $(nproc) / 2 ))}
AGENTSTREAM_RETRIEVER_STARTUP_TIMEOUT=${AGENTSTREAM_RETRIEVER_STARTUP_TIMEOUT:-1200}
if [[ -z "${EMBED_MODEL_PATH:-}" && -f "$AGENTSTREAM_LLMS_ROOT/Qwen3-Embedding-8B/config.json" ]]; then
	EMBED_MODEL_PATH=$AGENTSTREAM_LLMS_ROOT/Qwen3-Embedding-8B
fi

# benchmark 级 kwargs。Stage 1 与 Stage 3 共用同一套"默认 + 覆盖"合并逻辑：
#   - 结构性默认（subset、hle text_only 等）在 as_config.DEFAULT_BENCHMARK_KWARGS；
#   - 本 JSON 只放部署相关项（API 模型、服务地址）和与默认不同的 subset；
#   - bfcl 使用 multi_turn_base（与原始 AgentStream BENCHMARK_REGISTRY 一致）；
#   - 切换 subset 后 Stage 1/2 数据需重新生成。
if [[ -z "${AGENTSTREAM_BENCHMARK_KWARGS_JSON:-}" ]]; then
	AGENTSTREAM_BENCHMARK_KWARGS_JSON=$(printf \
		'{"bfcl":{"subset":"multi_turn_base"},"tau2":{"subset":"retail","user_simulator_model":"%s"},"hle":{"judge_model":"%s"},"browsecompplus":{"eval_model_id":"%s","retriever_url":"%s"}}' \
		"$AGENTSTREAM_API_MODEL" "$AGENTSTREAM_API_MODEL" "$AGENTSTREAM_API_MODEL" "$AGENTSTREAM_BROWSECOMP_RETRIEVER_URL")
fi

# exgentic benchmark venv 服务健康检查超时（秒）；exgentic 根目录见 §0 "根路径"。
EXGENTIC_VENV_HEALTH_TIMEOUT=${EXGENTIC_VENV_HEALTH_TIMEOUT:-120}
# Stage-3 单批 reset / step 的墙钟预算（秒）；超时 worker 被杀重建、该 slot 记零分。
# 每步 80 个并发会话时 appworld 的 DB 初始化更慢，reset 放宽到 900。
AGENTSTREAM_RL_RESET_TIMEOUT=${AGENTSTREAM_RL_RESET_TIMEOUT:-900}
AGENTSTREAM_RL_STEP_TIMEOUT=${AGENTSTREAM_RL_STEP_TIMEOUT:-600}

# ---- 任务流规模 --------------------------------------------------------------
# STREAM_SEED：域内顺序与跨域交错的随机种子（任务选择固定 seed 42，不受其影响）。
AGENTSTREAM_STREAM_SEED=${AGENTSTREAM_STREAM_SEED:-44}

# NUM_TASKS：训练流任务数（每个 benchmark 取 seed-42 shuffle 的前 N 个）。
# VAL_TASKS：holdout 数（紧随其后的 N..N+VAL 个，训练/验证不相交）。
#   - 上限受最小 subset 约束（见下方全集大小表）；超出时 select_holdout_tasks 会静默
#     退回训练集尾部（验证集与训练集重叠且无报错），故下方循环补了 WARNING。
#   - AgentStream 论文协议为 50（当前默认，与论文可比）；做 RL 泛化实验可用 96。
#   - 注意：(1) 改 NUM_TASKS 会同时移动 holdout（ids[N:N+VAL]），val 曲线与旧 run
#     不可比，实验名已自动带上 n{NUM_TASKS}；(2) Stage-1 的 SFT 选题（§2 的
#     SFT_NUM_TASKS）会跳过这段 holdout，改动 NUM_TASKS / VAL_TASKS 后 Stage-1 数据
#     需重新生成，重跑前请提升 AGENTSTREAM_RUN_VERSION，避免与旧产物目录混用。
AGENTSTREAM_NUM_TASKS=${AGENTSTREAM_NUM_TASKS:-50}
AGENTSTREAM_VAL_TASKS=${AGENTSTREAM_VAL_TASKS:-32}

# 各 benchmark 当前 subset 的任务全集大小（供上面的越界检查使用）：
#   bfcl            multi_turn_base 200
#   tau2            retail / telecom 114（airline 仅 50）
#   appworld        test_challenge 417（test_normal 168、train 90、dev 57）
#   hle             纯文本题约 2.1k（此处取保守下界 2000）
#   browsecompplus  830
declare -A _as_universe=([bfcl]=200 [tau2]=114 [appworld]=417 [hle]=2000 [browsecompplus]=830)
IFS=',' read -ra _as_bench_list <<< "$AGENTSTREAM_BENCHMARKS"
for _as_b in "${_as_bench_list[@]}"; do
	_as_size=${_as_universe[$_as_b]:-0}
	if (( _as_size > 0 && AGENTSTREAM_NUM_TASKS + AGENTSTREAM_VAL_TASKS > _as_size )); then
		echo "WARNING: NUM_TASKS+VAL_TASKS=$(( AGENTSTREAM_NUM_TASKS + AGENTSTREAM_VAL_TASKS )) > $_as_size ($_as_b subset size): holdout will overlap the train stream." >&2
	fi
done

# ---- 每题步数与观测预算 ------------------------------------------------------
# MAX_STEPS：全局步数上限，同时是 rollout 循环的轮数上限，取各 benchmark 需求的最大值。
# MAX_STEPS_JSON：按 benchmark 压短（值 <= 全局值才有效）。
#   - 提示词长度不随步数增长（history 窗口固定 history_length 条），调大步数的代价
#     只是 rollout 墙钟时间与训练 token 量。
#   - 原始 AgentStream 为 100 步/100 动作且格式错误不计步；SEED 的解析失败也消耗
#     预算，故需留余量。
#   - 取值依据：统一 40（bfcl multi_turn_base 零失误最多 16 步、tau2 retail 对话 15-30
#     轮、appworld 最长、browsecompplus 检索 + 作答都在 40 内）；只有 hle 例外为 3
#     （唯一动作是 finish：一次作答 + 两次格式错误余量；若给 40 步，失败题会产生
#     40 行无效动作样本稀释 mini-batch）。
#   - 本节两个 JSON 同时喂给 Stage 1（prepare_data.sh）与 Stage 3（hydra oc.env）。
AGENTSTREAM_MAX_STEPS=${AGENTSTREAM_MAX_STEPS:-40}
if [[ -z "${AGENTSTREAM_MAX_STEPS_JSON:-}" ]]; then
	AGENTSTREAM_MAX_STEPS_JSON='{"hle":3}'
fi

# 观测文本上限（字符）：默认 4096；browsecompplus 的 get_document 返回最长 2048 token
# 的整篇文档，放宽到 8192 以免证据被截掉。
if [[ -z "${AGENTSTREAM_OBS_MAX_CHARS_JSON:-}" ]]; then
	AGENTSTREAM_OBS_MAX_CHARS_JSON='{"browsecompplus":8192}'
fi


# =============================================================================
# §1 底座模型与派生量
# =============================================================================

# ---- 底座模型选择：换模型只改下面这一行（从列表里复制名称即可） --------------
# 可用模型（= $AGENTSTREAM_LLMS_ROOT 下的目录名）：
#   Qwen2.5-3B-Instruct
#   Qwen2.5-7B-Instruct
#   Qwen3-1.7B                  # 混合思考：thinking 自动关闭（见下方 thinking 块）
#   Qwen3-8B                    # 混合思考：thinking 自动关闭（见下方 thinking 块）
#   Qwen3-4B-Instruct-2507      # 纯 non-thinking，可直接使用
#   Qwen3.5-4B / Qwen3.5-9B     # 新架构 qwen3_5：当前 seed 环境 transformers/vllm 不认识，勿直接用
AGENTSTREAM_BASE_MODEL_NAME=${AGENTSTREAM_BASE_MODEL_NAME:-Qwen3-4B-Instruct-2507}
AGENTSTREAM_BASE_MODEL_PATH=${AGENTSTREAM_BASE_MODEL_PATH:-$AGENTSTREAM_LLMS_ROOT/$AGENTSTREAM_BASE_MODEL_NAME}

# 运行版本号：数据 / prompt / 奖励等配置断代时提升它，产生全新一代产物目录。
AGENTSTREAM_RUN_VERSION=${AGENTSTREAM_RUN_VERSION:-v4}

# ---- 由模型名自动派生（需要时仍可单独覆盖） ----------------------------------
# tag 规则：小写、去 "-instruct"、去点、"-" 转 "_"。
# 例：Qwen2.5-3B-Instruct -> qwen25_3b，Qwen3-4B-Instruct-2507 -> qwen3_4b_2507。
_as_model_tag=$(printf '%s' "$AGENTSTREAM_BASE_MODEL_NAME" \
	| tr '[:upper:]' '[:lower:]' | sed -e 's/-instruct//g' -e 's/\.//g' -e 's/-/_/g')
AGENTSTREAM_MODEL_TAG=${AGENTSTREAM_MODEL_TAG:-$_as_model_tag}
MODEL_TAG=${MODEL_TAG:-$AGENTSTREAM_MODEL_TAG}                     # Stage-2 train_sft.sh 的命名
MODEL_BASENAME=${MODEL_BASENAME:-$AGENTSTREAM_BASE_MODEL_NAME}

# ---- thinking 模式：全流程默认关闭（项目既定方针） ---------------------------
# Qwen3 混合思考系列（Qwen3-8B / -4B / -1.7B 等，非 2507）的 chat template 默认开启
# thinking，这里按模型名自动显式关闭。
#   - 关闭后模板会在生成前缀注入空 <think> 块，模型通常不再输出字面 <think> 标签，
#     因此同步放宽 Stage-1 的 require_think；
#   - Stage-3 侧 env_manager 检测到 qwen3 + enable_thinking=false 时按同一规则自动
#     放宽 projection 的 require_think，无需额外配置。
case "$AGENTSTREAM_BASE_MODEL_NAME" in
	Qwen3-*-2507*) _as_hybrid_thinking=false ;;  # 2507 系列纯 non-thinking，模板无开关
	Qwen3-*)       _as_hybrid_thinking=true ;;   # Qwen3 混合思考系列
	*)             _as_hybrid_thinking=false ;;  # Qwen2.5 / Qwen3.5 等
esac
AGENTSTREAM_DISABLE_THINKING=${AGENTSTREAM_DISABLE_THINKING:-$_as_hybrid_thinking}
if [[ "$AGENTSTREAM_DISABLE_THINKING" == "true" ]]; then
	# Stage 1：vLLM OpenAI 请求体里关闭 thinking（prepare_data.sh 已有此通道）。
	POLICY_EXTRA_BODY_JSON=${POLICY_EXTRA_BODY_JSON:-'{"chat_template_kwargs":{"enable_thinking":false}}'}
	# Stage 1：不再强制响应包含 <think>（模板已注入空 think 块）。
	AS_NO_REQUIRE_THINK=${AS_NO_REQUIRE_THINK:-true}
	# Stage 2/3：train_sft.sh 与 _common/agentstream.sh 读取本开关，向 hydra 追加
	# +data.apply_chat_template_kwargs.enable_thinking=false。
fi

# ---- 动作解析宽松度开关（当前默认全开；全关 = 严格解析） ----------------------
# RELAX_REQUIRE_THINK=true：解析端不再强制 <think>（prompt 仍要求思考）。
#   Stage-1 走 AS_NO_REQUIRE_THINK；Stage-3 追加 +env.projection_require_think=false。
# ACCEPT_TOOL_CALL=true：响应缺 <action> 时回退解析第一个 <tool_call> 块
#   （载荷同为 {"name","arguments"}，与原始 AgentStream 的原生 tool calling 同构）。
#   Stage-1 走 AS_ACCEPT_TOOL_CALL；Stage-3 追加 +env.projection_accept_tool_call=true。
# 注意：两个开关都会改变 Stage-3 的奖励 / 解析行为，改动后重跑请换实验名（避免
# auto resume 续到旧 ckpt）。
AGENTSTREAM_RELAX_REQUIRE_THINK=${AGENTSTREAM_RELAX_REQUIRE_THINK:-true}
AGENTSTREAM_ACCEPT_TOOL_CALL=${AGENTSTREAM_ACCEPT_TOOL_CALL:-true}
if [[ "$AGENTSTREAM_RELAX_REQUIRE_THINK" == "true" ]]; then
	AS_NO_REQUIRE_THINK=${AS_NO_REQUIRE_THINK:-true}
fi
if [[ "$AGENTSTREAM_ACCEPT_TOOL_CALL" == "true" ]]; then
	AS_ACCEPT_TOOL_CALL=${AS_ACCEPT_TOOL_CALL:-true}
fi

# =============================================================================
# §2 Stage 1/2：hindsight-skill 数据构造 + SFT
# =============================================================================
# 完整 runner（run_all.sh）仅在 POLICY_BASE_URL 不可达时才自行拉起并托管下方的
# 本地策略端点。

# ---- 产物路径 ----------------------------------------------------------------
# SFT_DATA_DIR：Stage-1 产出的 episode-skill 数据。
# SFT_MODEL_DIR：Stage-2 产出的 SFT 权重，同时是 Stage-3 的初始化；按模型与
#                RUN_VERSION 自动派生，确保新版本不会复用或覆盖旧权重。
# 两者都挂在 §0 的根路径下，换机器无需修改。
AGENTSTREAM_SFT_DATA_DIR=${AGENTSTREAM_SFT_DATA_DIR:-$AGENTSTREAM_SEED_ROOT/outputs/agentstream_episode_skill_pipeline_${AGENTSTREAM_MODEL_TAG}_${AGENTSTREAM_RUN_VERSION}}
AGENTSTREAM_SFT_MODEL_DIR=${AGENTSTREAM_SFT_MODEL_DIR:-$AGENTSTREAM_LLMS_ROOT/${AGENTSTREAM_BASE_MODEL_NAME}-agentstream-episode-skill-sft-${AGENTSTREAM_RUN_VERSION}}

# ---- Stage 1：数据构造 -------------------------------------------------------
# SFT 选题数（每 benchmark）：seed-42 顺序的前 N 题，跳过 RL holdout（ids[NUM_TASKS:NUM_TASKS+VAL_TASKS]）。
# 论文每域 180 题；这里 100 = 训练流 50 题 + holdout 之后的 50 题。全集不足时取到用尽
# （tau2 retail 114 题 -> 82 题）。
AGENTSTREAM_SFT_NUM_TASKS=${AGENTSTREAM_SFT_NUM_TASKS:-100}
AGENTSTREAM_SFT_ROLLOUTS_PER_TASK=${AGENTSTREAM_SFT_ROLLOUTS_PER_TASK:-8}
# 并发 rollout 会话数：留空时在下方策略端点配置后按副本数派生（16 x 副本数）。
AGENTSTREAM_SFT_PARALLEL_SESSIONS=${AGENTSTREAM_SFT_PARALLEL_SESSIONS:-}
AGENTSTREAM_SFT_SKILL_GEN_WORKERS=${AGENTSTREAM_SFT_SKILL_GEN_WORKERS:-32}
AGENTSTREAM_SFT_VAL_RATIO=${AGENTSTREAM_SFT_VAL_RATIO:-0.1}
# Stage-1 prompt 的 history 窗口条数（Stage-3 对应变量为 §3 的 history_length）。
HISTORY_LENGTH=${HISTORY_LENGTH:-2}

# ---- Stage 2：SFT 训练 -------------------------------------------------------
AGENTSTREAM_SFT_EPOCHS=${AGENTSTREAM_SFT_EPOCHS:-3}
AGENTSTREAM_SFT_GPUS=${AGENTSTREAM_SFT_GPUS:-0,1}
AGENTSTREAM_SFT_NPROC=${AGENTSTREAM_SFT_NPROC:-2}
AGENTSTREAM_SFT_TRAIN_BATCH_SIZE=${AGENTSTREAM_SFT_TRAIN_BATCH_SIZE:-12}
AGENTSTREAM_SFT_MICRO_BATCH_SIZE=${AGENTSTREAM_SFT_MICRO_BATCH_SIZE:-1}
# 序列并行度：80 GB 双卡需要 2（两卡合切一条 28k 序列）；143 GB 单卡放得下，1 = 两路数据并行，
# 吞吐约翻倍。TRAIN_BATCH_SIZE 须能被 (NPROC/SP) x MICRO_BATCH 整除。
AGENTSTREAM_SFT_ULYSSES_SEQUENCE_PARALLEL_SIZE=${AGENTSTREAM_SFT_ULYSSES_SEQUENCE_PARALLEL_SIZE:-1}
# SFT 样本总长上限（train_sft.sh 的 data.max_length；覆盖其 12288 默认值）。样本 = 整条轨迹的
# 分析 prompt + skill，长度由轨迹决定而非 HISTORY_LENGTH：v4 数据（五域、40 步）实测最长 59787
# token，超过 28672 的 116 条全部来自 browsecompplus（get_document 整篇文档），无一超过 65536。
# 训练器 truncation=error，上限必须覆盖最长样本；H200 单卡放得下 64k（SP=1），80 GB 卡请配 SP=2。
MAX_LENGTH=${MAX_LENGTH:-65536}

# ---- 样本检视与训练日志 -------------------------------------------------------
INSPECTION_SAMPLES=${INSPECTION_SAMPLES:-3}
INSPECTION_MAX_CHARS=${INSPECTION_MAX_CHARS:-4000}
SFT_LOG_DATA_SAMPLES=${SFT_LOG_DATA_SAMPLES:-3}
SFT_LOG_DATA_SAMPLES_FREQ=${SFT_LOG_DATA_SAMPLES_FREQ:-10}
SFT_LOG_DATA_SAMPLES_MAX_CHARS=${SFT_LOG_DATA_SAMPLES_MAX_CHARS:-4000}

# ---- 本地基线策略端点（仅 Stage-1 数据构造期间使用） -------------------------
# POLICY_GPU 支持逗号分隔的多卡列表（默认 0,1）：每 POLICY_TP 张卡起一个完整
# vLLM 副本做数据并行，端口从 POLICY_PORT 起依次递增，rollout 请求自动轮询分摊到
# 全部副本。
AGENTSTREAM_POLICY_HOST=${AGENTSTREAM_POLICY_HOST:-127.0.0.1}
AGENTSTREAM_POLICY_PORT=${AGENTSTREAM_POLICY_PORT:-60001}
AGENTSTREAM_POLICY_GPU=${AGENTSTREAM_POLICY_GPU:-0,1}
AGENTSTREAM_POLICY_TP=${AGENTSTREAM_POLICY_TP:-1}
# 并发会话数派生：24 x 策略副本数（显式设置 AGENTSTREAM_SFT_PARALLEL_SESSIONS 时优先）。
# 143 GB 卡上 vLLM KV cache 约 75 万 token，48 并发 x 最长 32k 超出时由 vLLM 抢占排队，
# 不会 OOM；瓶颈在 benchmark 会话与用户模拟器 API。
if [[ -z "${AGENTSTREAM_SFT_PARALLEL_SESSIONS:-}" ]]; then
	_as_policy_replicas=$(( $(awk -F',' '{print NF}' <<< "$AGENTSTREAM_POLICY_GPU") / AGENTSTREAM_POLICY_TP ))
	if (( _as_policy_replicas < 1 )); then
		_as_policy_replicas=1
	fi
	AGENTSTREAM_SFT_PARALLEL_SESSIONS=$(( 24 * _as_policy_replicas ))
fi
# Stage-1 vLLM 独占整卡（H200 143 GB）：0.85 = 权重 8 GB + KV 约 110 GB；80 GB 卡请降回 0.6。
AGENTSTREAM_POLICY_GPU_MEMORY_UTILIZATION=${AGENTSTREAM_POLICY_GPU_MEMORY_UTILIZATION:-0.85}
AGENTSTREAM_POLICY_MAX_MODEL_LEN=${AGENTSTREAM_POLICY_MAX_MODEL_LEN:-32768}
AGENTSTREAM_VLLM_STARTUP_TIMEOUT=${AGENTSTREAM_VLLM_STARTUP_TIMEOUT:-180}


# =============================================================================
# §3 Stage 3：自进化 OPD RL
# =============================================================================

# ---- stream profile ------------------------------------------------------------
# 两种 run 只差一个开关 AGENTSTREAM_RL_STREAM_PROFILE（其余变量按 profile 派生，
# 显式设置的值始终优先）：
#   single_pass  Run A（当前默认）。严格单遍在线 RL：on_exhausted=stop，每题只见一次，
#                步数自动 = ceil(benchmark 数 x NUM_TASKS / TRAIN_DATA_SIZE)，流走完即停。
#                每步任务数默认等于 GPU 数（双卡时为 2），以获得更细的在线更新
#                粒度；RL 的收益只能通过"先做的题改进后做的题"体现，与 AgentStream
#                记忆型方法的作用机制同构。对照组：AGENTSTREAM_RL_ACTOR_LR=0
#                （权重冻结的 SFT 策略走同一条流，同样的 online/* 曲线）。
#   multipass    Run B。多遍 RL：on_exhausted=cycle，整条流按固定顺序反复循环
#                AGENTSTREAM_RL_EPOCHS 步（288 题 / 12 题每步 = 24 步一遍）。
#                产出：holdout 验证曲线 val/{slug}_success_rate（RL 口径：泛化 +
#                跨块遗忘）以及第一遍的首遍累计分 wandb online/*（AgentStream 口径）。
# 两种 run 都必须与要对比的基线 run 使用相同的 stream mode 与 AGENTSTREAM_STREAM_SEED
# ——首遍累计分是顺序相关的（先出现的题由更"生"的策略作答）。
#
# wandb 指标：
#   online/cumulative_avg_score         首遍全部副本，mean@GROUP_SIZE
#   online/single/cumulative_avg_score  每题只取第一条副本，与基线的每题一次尝试对齐
#   online/{slug}/...                   按 benchmark 拆分
#   *_success_rate                      上述各项对应的成功率版本
# 多遍 / 续训 run 可开 AGENTSTREAM_RL_TRACK_REPEAT_PASSES=true 额外记录第 K 遍的
# online/pass<K>/* 累计曲线（见下方开关注释）。
AGENTSTREAM_RL_STREAM_PROFILE=${AGENTSTREAM_RL_STREAM_PROFILE:-single_pass}
AGENTSTREAM_RL_MODES=${AGENTSTREAM_RL_MODES:-sequential,interleaved,isolated}
AGENTSTREAM_RL_PROTOCOL=${AGENTSTREAM_RL_PROTOCOL:-online}
AGENTSTREAM_RL_VAL_SOURCE=${AGENTSTREAM_RL_VAL_SOURCE:-holdout}

# 保持 1：>1 时块内重复访问仍是 pass 0，会被计入首遍累计分（记录器按 pass_idx 判首遍）。
AGENTSTREAM_RL_BLOCK_PASSES=${AGENTSTREAM_RL_BLOCK_PASSES:-1}

# 多遍 run（on_exhausted=cycle）时把第 2/3… 遍也各记一套独立累计曲线 online/pass<K>/*
# （子树与首遍 online/* 完全同构：全副本 + single + 按 benchmark 拆分，分母只数该遍
# 已遇到的 episode）。false = 现状，仅首遍计入；首遍口径不受本开关影响。开关可在
# resume 时才打开：已写入 JSONL 的 repeat 行会在恢复累计器时一并补回。
AGENTSTREAM_RL_TRACK_REPEAT_PASSES=${AGENTSTREAM_RL_TRACK_REPEAT_PASSES:-false}

# ---- 资源与采样 ---------------------------------------------------------------
AGENTSTREAM_RL_GPUS=${AGENTSTREAM_RL_GPUS:-0,1}
AGENTSTREAM_RL_N_GPUS=${AGENTSTREAM_RL_N_GPUS:-2}
AGENTSTREAM_RL_GROUP_SIZE=${AGENTSTREAM_RL_GROUP_SIZE:-8}

# ---- 按 profile 派生流长度 / 每步任务数 ------------------------------------------
_as_n_bench=$(awk -F',' '{print NF}' <<< "$AGENTSTREAM_BENCHMARKS")
case "$AGENTSTREAM_RL_STREAM_PROFILE" in
	multipass)
		AGENTSTREAM_RL_ON_EXHAUSTED=${AGENTSTREAM_RL_ON_EXHAUSTED:-cycle}
		AGENTSTREAM_RL_TRAIN_DATA_SIZE=${AGENTSTREAM_RL_TRAIN_DATA_SIZE:-12}
		# 混合模式 90 步 ~ 3.75 遍（288 题）；isolated 每个 benchmark 40 步 = 5 遍（96 题）。
		AGENTSTREAM_RL_EPOCHS=${AGENTSTREAM_RL_EPOCHS:-90}
		AGENTSTREAM_RL_ISOLATED_EPOCHS=${AGENTSTREAM_RL_ISOLATED_EPOCHS:-40}
		;;
	single_pass)
		AGENTSTREAM_RL_ON_EXHAUSTED=${AGENTSTREAM_RL_ON_EXHAUSTED:-stop}
		# 每步任务数须被 GPU 数整除（agentstream.sh 会检查），最小值即 GPU 数。
		AGENTSTREAM_RL_TRAIN_DATA_SIZE=${AGENTSTREAM_RL_TRAIN_DATA_SIZE:-$AGENTSTREAM_RL_N_GPUS}
		# 默认双卡恰好一遍：3 x 96 / 2 = 144 步；isolated 每域 96 / 2 = 48 步。
		AGENTSTREAM_RL_EPOCHS=${AGENTSTREAM_RL_EPOCHS:-$(( (_as_n_bench * AGENTSTREAM_NUM_TASKS + AGENTSTREAM_RL_TRAIN_DATA_SIZE - 1) / AGENTSTREAM_RL_TRAIN_DATA_SIZE ))}
		AGENTSTREAM_RL_ISOLATED_EPOCHS=${AGENTSTREAM_RL_ISOLATED_EPOCHS:-$(( (AGENTSTREAM_NUM_TASKS + AGENTSTREAM_RL_TRAIN_DATA_SIZE - 1) / AGENTSTREAM_RL_TRAIN_DATA_SIZE ))}
		# 流调度器位置随 checkpoint 一起保存（global_step_N/stream_state.json），auto resume
		# 可从中断处精确续接流（配合较小的 SAVE_FREQ）。当前此处强制 disable，即单遍
		# run 总是从头开始（下方 RESUME_MODE 的 :-auto 默认不会覆盖它）；需要续跑时改这一行。
		AGENTSTREAM_RL_RESUME_MODE=disable
		# 单遍跑完后想在同一 checkpoint 上多训几遍：保持 profile=single_pass（实验名不变，
		# auto resume 才找得到旧 ckpt，需先把上面的 RESUME_MODE 改回 auto），caller 覆盖三个
		# 变量即可，例如
		#   AGENTSTREAM_RL_ON_EXHAUSTED=cycle AGENTSTREAM_RL_EPOCHS=432 \
		#   AGENTSTREAM_RL_TRACK_REPEAT_PASSES=true bash run_agentstream_sft_glm_self.sh interleaved
		# 每遍 = benchmark 数 x NUM_TASKS / TRAIN_DATA_SIZE（默认 3x96/2 = 144 步），
		# EPOCHS=288/432 即共 2/3 遍。调度器从流末尾（cursor=288）恢复后下一步自动进入
		# pass 1，严格按原顺序重放；pass>=1 不计入首遍 online/* 曲线（保持冻结）。
		;;
	*)
		echo "Unknown AGENTSTREAM_RL_STREAM_PROFILE='$AGENTSTREAM_RL_STREAM_PROFILE' (use multipass | single_pass)" >&2
		# bash 4.4 的 errexit 不会因 source 返回非零而中止，这里直接终止调用脚本；
		# 交互式 shell 里只 return，避免关掉终端。
		if [[ $- == *i* ]]; then return 1; else exit 1; fi
		;;
esac

# ---- 验证 ------------------------------------------------------------------------
# 每次覆盖全部 holdout，每题重复 VAL_REPEATS 次取均值（mean@k，压低 T=0.4 的采样噪声）。
#   - 槽位数由 agentstream.sh 按实际 benchmark 数派生（benchmark 数 x VAL_TASKS x
#     VAL_REPEATS：混合模式 3x16x2=96，isolated 1x16x2=32），需要固定值时显式设置
#     AGENTSTREAM_RL_VAL_DATA_SIZE。验证成本 = 槽位数 条 episode / 次。
#   - 不要用 val_kwargs.n 实现重复：verl-agent 的验证环境数 = val_batch_size x 1，
#     n>1 会触发 batch 与环境数不等的断言。
AGENTSTREAM_RL_VAL_REPEATS=${AGENTSTREAM_RL_VAL_REPEATS:-1}
AGENTSTREAM_RL_VAL_DATA_SIZE=${AGENTSTREAM_RL_VAL_DATA_SIZE:-}
AGENTSTREAM_RL_VAL_BEFORE_TRAIN=${AGENTSTREAM_RL_VAL_BEFORE_TRAIN:-False}
AGENTSTREAM_RL_TEST_FREQ=${AGENTSTREAM_RL_TEST_FREQ:-5}

# ---- 优化目标 --------------------------------------------------------------------
# 设为 0 得到权重冻结的对照 run（同一条流、同样的 online/* 曲线）。
AGENTSTREAM_RL_ACTOR_LR=${AGENTSTREAM_RL_ACTOR_LR:-1e-6}

# 熵正则系数（verl 默认 0.001）。非零时更新阶段要为 entropy 生成全词表 fp32 张量
# （152k 词表下一条 29k token 样本约 16 GiB）并放弃 log-prob 的 in-place backward，
# 4B 模型 + 28672 prompt 在 80GB 卡上会 OOM，故正式配置设 0。
#   - 影响：训练目标少了 0.001 x entropy 这一极弱正则（DAPO 等 GRPO 系配方同为 0），
#     与旧 run 目标不同，实验记录需注明；
#   - actor/entropy_loss 指标不受影响，仍可用来监控熵坍缩。
AGENTSTREAM_RL_ENTROPY_COEFF=${AGENTSTREAM_RL_ENTROPY_COEFF:-0}

# 跳过 compute_log_prob 路径（old_log_prob 重算 + OPD teacher 打分）里硬编码的全词表
# 熵计算——该路径不受 ENTROPY_COEFF 门控，是 appworld 长 micro-batch OOM 的主要瞬时
# 尖峰来源（25600 token x 152k 词表 ≈ 额外 ~15 GiB）。
#   - true 的代价：wandb 失去 actor/entropy_loss 曲线（熵坍缩监控）；训练目标与梯度
#     完全不变（update 阶段的熵仍由 ENTROPY_COEFF 独立控制，teacher 侧的熵本就算完
#     即弃）。
#   - false = SEED 原逻辑。
AGENTSTREAM_RL_SKIP_ENTROPY_IN_LOG_PROB=${AGENTSTREAM_RL_SKIP_ENTROPY_IN_LOG_PROB:-true}

# ---- 序列长度与批大小 / 显存 -------------------------------------------------------
# prompt 上限（token）。remove_padding + 动态微批下开销只随样本真实长度变化，放宽只影响
# appworld 里 24576~32768 之间原本被 filter_overlong_prompts 丢弃的样本，其余 benchmark
# 的 prompt 由固定 history 窗口决定，不因上限变大而变长。改动时须同步满足：
#   PPO_MAX_TOKEN_LEN_PER_GPU >= MAX_PROMPT_LENGTH + 1024（verl 动态微批断言）
#   SEED_ANALYSIS_MAX_MODEL_LEN >= MAX_PROMPT_LENGTH + 1024（rollout vLLM 上下文）
MAX_PROMPT_LENGTH=${MAX_PROMPT_LENGTH:-32768}
# rollout / analysis 共用的 vLLM max_model_len（_common/agentstream.sh 默认 20480，低于
# prompt+response 会在生成时报上下文超限）。
SEED_ANALYSIS_MAX_MODEL_LEN=${SEED_ANALYSIS_MAX_MODEL_LEN:-40960}
# Stage-3 prompt 的 history 窗口条数（Stage-1 对应变量为 §2 的 HISTORY_LENGTH）。
history_length=${history_length:-2}
AGENTSTREAM_RL_PPO_MINI_BATCH_SIZE=${AGENTSTREAM_RL_PPO_MINI_BATCH_SIZE:-96}
AGENTSTREAM_RL_PPO_MICRO_BATCH_SIZE=${AGENTSTREAM_RL_PPO_MICRO_BATCH_SIZE:-4}
AGENTSTREAM_RL_LOG_PROB_MICRO_BATCH_SIZE=${AGENTSTREAM_RL_LOG_PROB_MICRO_BATCH_SIZE:-8}
# 动态微批：按 token 预算打包，bfcl 短样本（~6k）一个微批装 ~8 条、appworld 长样本
# （~20k）2 条，短样本不再为最坏情况买单。
#   - 开启后上面的 PPO/LOG_PROB 微批大小被忽略；纯工程加速，mini-batch 梯度语义不变，
#     可与旧实验续跑 / 对比。
#   - 显存估算（Qwen3-4B，两卡 FSDP，ENTROPY_COEFF=0）：常驻约 36 GB + 更新相约
#     0.65 MB/token -> 49152 时峰值约 68 GB，H200 143 GB 余量充足；80 GB 卡用 25600
#     （= 24576+1024，动态微批允许的最小值）。
USE_DYNAMIC_BSZ=${USE_DYNAMIC_BSZ:-True}
PPO_MAX_TOKEN_LEN_PER_GPU=${PPO_MAX_TOKEN_LEN_PER_GPU:-49152}

# ---- checkpoint 与实验名 -------------------------------------------------------------
AGENTSTREAM_RL_SAVE_FREQ=${AGENTSTREAM_RL_SAVE_FREQ:-10}
# 只保留最近一份 checkpoint（4B + 优化器状态约 50 GB 一份）；续跑与"已完成即跳过"只需要最新一份。
AGENTSTREAM_RL_MAX_CKPT_TO_KEEP=${AGENTSTREAM_RL_MAX_CKPT_TO_KEEP:-1}
AGENTSTREAM_RL_RESUME_MODE=${AGENTSTREAM_RL_RESUME_MODE:-auto}
# 实验名带上任务数与 profile：换 NUM_TASKS 会移动 holdout，换 profile 会改变流长度，
# 两者都不应 auto resume 到旧 checkpoint。RUN_VERSION 断开不同代际的训练产物。
AGENTSTREAM_EXPERIMENT_PREFIX=${AGENTSTREAM_EXPERIMENT_PREFIX:-${AGENTSTREAM_METHOD_TAG:-seed}_${AGENTSTREAM_MODEL_TAG}_agentstream_${AGENTSTREAM_RUN_VERSION}_n${AGENTSTREAM_NUM_TASKS}_${AGENTSTREAM_RL_STREAM_PROFILE}}

# ---- wandb rollout 样本 ---------------------------------------------------------------
WANDB_ROLLOUT_SAMPLES=${WANDB_ROLLOUT_SAMPLES:-3}
WANDB_ROLLOUT_SAMPLE_FREQ=${WANDB_ROLLOUT_SAMPLE_FREQ:-10}
WANDB_ROLLOUT_SAMPLE_MAX_CHARS=${WANDB_ROLLOUT_SAMPLE_MAX_CHARS:-4000}


# =============================================================================
# §4 SEED skill / OPD
# =============================================================================

# ---- 单轨 OPD（SEED 原有） ---------------------------------------------------------
# OPD 从第一次更新起就生效；Stage-1 checkpoint 预期已能理解原始 SEED analysis prompt。
AGENTSTREAM_SEED_SKILL_MODE=${AGENTSTREAM_SEED_SKILL_MODE:-episode_only}
AGENTSTREAM_SEED_OPD_LOSS_COEF=${AGENTSTREAM_SEED_OPD_LOSS_COEF:-0.005}

# ---- 双轨 OPD（spec + gen 两路技能蒸馏） ------------------------------------------------
# 机制回顾：OPD 对轨迹中每个 token 计算
#   gate = sigmoid(beta * (teacher_logprob - student_logprob))
#   loss = gate * (teacher_logprob - student_logprob)
# 即只在「看了 skill 的 teacher 比学生更确信该动作」的 token 上把学生向 teacher 拉近。
# spec 通道（SEED 原有）：teacher prompt 注入本轨迹自己的 episode skill（局部技能），
# 强度 = 上面的 OPD_LOSS_COEF。以下为新增的 gen 通道及两通道共用的旋钮。

# gen 通道（第二路 OPD）的损失权重，即 global/general skill 的蒸馏强度。
#   - teacher prompt 单独注入 "General Skill" 段并独立打分（当前内容 = 本轨迹 episode
#     skill 的拷贝，经验池上线后换成跨样本汇总的通用技能，损失侧无需再改）。
#   - 0 = 关闭 gen 通道，训练与原单轨完全一致（默认，保持基线）。
#   - 双轨实验建议 OPD_LOSS_COEF=0.005 + OPD_GEN_LOSS_COEF=0.005：拷贝阶段两通道
#     信号几乎相同，总蒸馏压强需与单轨 0.01 持平才能公平对比。
AGENTSTREAM_SEED_OPD_GEN_LOSS_COEF=${AGENTSTREAM_SEED_OPD_GEN_LOSS_COEF:-0.005}

# 置信下限（spec/gen 两通道共用）：|teacher_logprob - student_logprob| < eps 的 token
# 不参与蒸馏。
#   - 直觉：gap≈0 说明 skill 对该 token 没提供额外信息，但 sigmoid gate 仍输出≈0.5，
#     会产生半强度的无效模仿梯度；过滤掉可降噪（双通道叠加时此类噪声翻倍，更有必要）。
#   - 0 = 不过滤（与原行为一致）；建议起步值 0.05。
AGENTSTREAM_SEED_OPD_GATE_EPS=${AGENTSTREAM_SEED_OPD_GATE_EPS:-0.0}

# gen 相对 spec 的 token 级路由规则：
#   none        两通道独立叠加（默认；每路 gate 各自决定在哪些 token 出力）。
#   spec_first  gen 通道每个 token 的权重额外乘以 (1 - spec_gate)。注意语义是
#               "重分配"而非"衰减"：token-mean 按权重归一化，gen 总强度仍≈系数值，
#               只是移向 spec gate 低的 token。拷贝阶段两通道 gate 相同，权重恰在
#               无信息 token（gate≈0.5）处最大，故 spec_first 消融必须搭配
#               OPD_GATE_EPS>0（先滤掉 gap≈0 的 token）；正式双轨保持 none。
# （gen 通道的 gate 锐度 beta 默认继承 spec；如需单独调，在调用侧 export
#  SEED_OPD_GEN_GATE_BETA 覆盖 agentstream.sh 的默认值。）
AGENTSTREAM_SEED_OPD_GEN_DOMINANCE=${AGENTSTREAM_SEED_OPD_GEN_DOMINANCE:-none}

# ---- Global 经验池（gen 通道的 skill 来源，见 SEED/GLOBAL_SKILL_POOL_V1.md）----
# copy = gen 蒸馏本轨迹 episode skill 的拷贝（占位基线，当前默认）。
# pool = gen 从跨任务经验池检索：每步把通过"迁移性 LLM 判定"（OpenRouter GLM，
#        需 OPENROUTER_API_KEY，缺失则准入静默停用）的 hindsight skill 原文入池；
#        检索 query = 环境提供的任务全文 + 首步观测（tau2 的任务身份只在用户开
#        场白里）的 embedding，与池内 skill 余弦取 top-1 且排除同一任务
#        （slug::task_id）来源的条目；低于 MIN_SIM 或池为空时该轨迹跳过 gen
#        通道（不回退 copy，保持语义单一）。
# 注意：开 pool 属于训练目标变更，请换 AGENTSTREAM_EXPERIMENT_PREFIX，避免
# auto resume 续到 copy 语义的旧 ckpt。
AGENTSTREAM_SEED_GLOBAL_POOL_SOURCE=${AGENTSTREAM_SEED_GLOBAL_POOL_SOURCE:-pool}
# 检索相似度下限（余弦，0-1）：越高越保守，命中率与噪声同降。起步 0.35。
AGENTSTREAM_SEED_GLOBAL_POOL_MIN_SIM=${AGENTSTREAM_SEED_GLOBAL_POOL_MIN_SIM:-0.3}
# judge 迁移性分数的准入门槛（0-1）：越高池子越小越精。起步 0.6。
AGENTSTREAM_SEED_GLOBAL_POOL_SCORE_THRESHOLD=${AGENTSTREAM_SEED_GLOBAL_POOL_SCORE_THRESHOLD:-0.6}
# 是否允许"失败轨迹"的 avoidance skill 参加准入（True/False）。开启后使用有符号
# utility：成功轨迹取 spec_gap，失败轨迹取 -spec_gap；只有 utility>0 才送 judge。
AGENTSTREAM_SEED_GLOBAL_POOL_ADMIT_FAILED=${AGENTSTREAM_SEED_GLOBAL_POOL_ADMIT_FAILED:-True}

# ---- 可选改进开关（三项，默认关闭 = 原始逻辑逐 bit 不变；说明见 SEED/README.md "可选改进开关"）----
# 背景：OPD 损失 loss = gate·(teacher_lp − student_lp) 的梯度对每个 token 都是 −gate，
# 只会"推高"学生已采样的 token，永远不"推低"。由此产生三个问题，三个开关各对一个。
#
# [1] 失败轨迹 skill 的正向措辞 + 准入放行（True/False）。
#     原始：失败轨迹的 episode_skill 写成 avoidance 规则（"避免 X"），其信号落在需要
#     推低的 token 上，单边损失无法利用；池准入还要求它把失败轨迹的概率压低（-spec_gap>0）。
#     开启：分析 prompt 改为写"本应遵循的规则"（正向 workflow，spec 与 gen 通道同时受益）；
#     池准入对失败候选不再做 spec_gap 门控，固定排在所有成功候选之后，judge 是唯一过滤器。
#     依赖：池侧放行需要上面的 GLOBAL_POOL_ADMIT_FAILED=True（默认已是）；为 False 时失败候选
#     在收集阶段即被丢弃，本开关只改 prompt，启动时会打 warning。
#     注意：若启用 skill_gen 且 FAILED_REWARD_MODE=negate，语义与本开关矛盾，需改回 zero。
AGENTSTREAM_SEED_FAILED_SKILL_POSITIVE=${AGENTSTREAM_SEED_FAILED_SKILL_POSITIVE:-False}
#
# [2] 池淘汰策略：gate_ema | lru | window。
#     gate_ema（原始）：满员时淘汰 gate EMA 最低者，从未注入者按 0.5 中性值参与；EMA 是
#             一致性量，实际值聚在 0.5 略下，会先淘汰被检索过的活跃条目。
#     lru：淘汰最久未被检索者（从未检索者以入池步计），直接针对"占位不用"的死重。
#     window：每步删除入池早于 (当前步 − WINDOW_STEPS) 的条目，检索不续命；满员时按入池
#             步 FIFO。语义是近因先验，会清掉跨域旧 skill，请作为命名消融使用。
#     观测：seed/global_pool/{evicted_total, expired, never_injected_ratio}。
AGENTSTREAM_SEED_GLOBAL_POOL_EVICT_POLICY=${AGENTSTREAM_SEED_GLOBAL_POOL_EVICT_POLICY:-gate_ema}
AGENTSTREAM_SEED_GLOBAL_POOL_WINDOW_STEPS=${AGENTSTREAM_SEED_GLOBAL_POOL_WINDOW_STEPS:-48}
#
# [3] 只在正 gap token 上施加 OPD 损失（True/False，spec 与 gen 两通道共用）。
#     原始：gap<0 的 token（加了 skill 的 teacher 反而更不确信）仍以 gate∈(0,0.5) 的权重被
#     推高，方向与 teacher 相反，等价于对自己 rollout 的半权重 BC，失败轨迹的错误动作也在内。
#     开启：这些 token 的损失置零；token-mean 分母与全部 actor/opd_* 指标仍按原 mask 统计，
#     系数语义与曲线口径不变，opd_loss 变为非负。与 OPD_GATE_EPS 可叠加。
AGENTSTREAM_SEED_OPD_POSITIVE_ONLY=${AGENTSTREAM_SEED_OPD_POSITIVE_ONLY:-False}

# ---- 流式稳定化：EMA 影子与经验回放（设计与原理见 SEED/EMA_REPLAY_DESIGN.md）---------------
# 两者默认关闭，关闭时训练逻辑与原来逐 bit 一致；开启后算法不使用任何任务 / 域标签。
#
# EMA 影子：每训练 step 后把影子参数朝当前参数挪 (1-tau)，影子 ≈ 最近 1/(1-tau) 步的
# 参数平均，各批任务的专属偏向在平均中抵消。影子为 fp32、常驻 pinned CPU，打分时临时
# 换入模型（参数交换），不额外占显存。
#   off      关闭（默认）。
#   ref      KL 参照从固定的 SFT 起点改为影子（要求 use_kl_loss=True）。
#   teacher  OPD 三路 teacher 打分（episode / step / general）改用「影子 + skill prompt」
#            作底座，切断「学生自己当 teacher」的漂移复利（要求任一 OPD 系数 > 0）。
#   both     两者同时。
# 建议先跑 teacher：它直接对应「OPD 系数减半反而变好」这一观察。
AGENTSTREAM_SEED_EMA_MODE=${AGENTSTREAM_SEED_EMA_MODE:-ref}
# tau 的语义是流上的 step 数：0.9 ≈ 10 步视野；48 步的单遍流上不要用 0.99（≈固定 ref）。
AGENTSTREAM_SEED_EMA_TAU=${AGENTSTREAM_SEED_EMA_TAU:-0.9}
#
# 经验回放：advantage 算完后把每个任务组（8 条轨迹的全部 step 样本）以蓄水池采样存入
# 缓冲区（始终 ≈ 整条流的均匀子集，不用域标签），每步再均匀抽 GROUPS_PER_STEP 组拼进
# actor 更新。不重新与环境交互，首遍在线分不受影响；off-policy 由 PPO 的 ratio clip
# 处理。只在 sequential / interleaved 上开；isolated 下等于复习同域旧题，与假设无关。
AGENTSTREAM_SEED_REPLAY_ENABLE=${AGENTSTREAM_SEED_REPLAY_ENABLE:-True}
AGENTSTREAM_SEED_REPLAY_GROUPS_PER_STEP=${AGENTSTREAM_SEED_REPLAY_GROUPS_PER_STEP:-3}
# 容量（组数）同时决定 driver 内存（每组约 100 MB）与回放样本的最大年龄；resume 后缓冲区为空。
AGENTSTREAM_SEED_REPLAY_CAPACITY=${AGENTSTREAM_SEED_REPLAY_CAPACITY:-32}

# ---- skill analysis 后端 ---------------------------------------------------------------
AGENTSTREAM_SEED_ANALYSIS_BACKEND=${AGENTSTREAM_SEED_ANALYSIS_BACKEND:-policy_vllm}
AGENTSTREAM_SEED_ANALYSIS_PROMPT_VERSION=${AGENTSTREAM_SEED_ANALYSIS_PROMPT_VERSION:-seed}
AGENTSTREAM_SEED_ANALYSIS_MAX_COMPLETION_TOKENS=${AGENTSTREAM_SEED_ANALYSIS_MAX_COMPLETION_TOKENS:-1024}
AGENTSTREAM_SEED_ANALYSIS_MAX_STEP_SKILLS=${AGENTSTREAM_SEED_ANALYSIS_MAX_STEP_SKILLS:-1}


# =============================================================================
# §5 阶段开关（scripts/sft/agentstream/run_all.sh）
# =============================================================================
AGENTSTREAM_RUN_PREPARE=${AGENTSTREAM_RUN_PREPARE:-true}
AGENTSTREAM_RUN_SFT=${AGENTSTREAM_RUN_SFT:-true}
AGENTSTREAM_RUN_RL=${AGENTSTREAM_RUN_RL:-true}
