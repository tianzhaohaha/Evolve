# Copy to SEED/.env on each server; never commit the populated .env.
# Bash syntax: KEY=value (no spaces around '='). Do not source with bash -x.
# Formal launchers load .env first, then agentstream_full.env with set -a.

CONDA_ENV=seed-as

# Default layout is inferred from the checkout, independent of the username:
#   <Evolve>/LLMs/Qwen3-4B-Instruct-2507
#   <Evolve>/LLMs/Qwen3-Embedding-8B
#   <Evolve>/LLMs/Qwen3-4B-Instruct-2507-agentstream-episode-skill-sft-v2
#   <Evolve>/ckpt/<experiment_name>
# No path overrides are needed for this layout. For other storage locations:
# AGENTSTREAM_LLMS_ROOT=/your/storage/LLMs
# CHECKPOINTS_ROOT=/your/storage/ckpt
# AGENTSTREAM_SFT_MODEL_DIR=/your/storage/an-existing-sft-model
# AGENTSTREAM_EXGENTIC_ROOT=/your/other/checkout/AgentStream/exgentic

# Optional scratch root. Leave unset to respect the server/job TMPDIR.
# This is expanded only after agentstream_full.env is sourced; for standalone
# exgentic install, set/export TMPDIR explicitly before running the installer.
# AGENTSTREAM_TMP_ROOT=/your/scratch/agentstream

# Default two-GPU deployment. Match these to the GPUs allocated to your job.
AGENTSTREAM_RL_GPUS=0,1
AGENTSTREAM_RL_N_GPUS=2
AGENTSTREAM_SFT_GPUS=0,1
AGENTSTREAM_SFT_NPROC=2
AGENTSTREAM_POLICY_GPU=0,1
# Shares GPU 1 with policy/training: check memory or use a remote retriever.
AGENTSTREAM_RETRIEVER_GPU=1
# AGENTSTREAM_BROWSECOMP_RETRIEVER_URL=http://retriever-host:60100
# AGENTSTREAM_RETRIEVER_AUTO_START=0

# Keep public benchmark defaults: bfcl,tau2,browsecompplus.
# Fill real credentials ONLY in .env; an empty value does not enable a service.
OPENROUTER_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
HF_TOKEN=
WANDB_API_KEY=
WANDB_MODE=offline

# Use a new experiment prefix for a fresh test to avoid mixing old run outputs.
# AGENTSTREAM_EXPERIMENT_PREFIX=agentstream_newserver_smoke