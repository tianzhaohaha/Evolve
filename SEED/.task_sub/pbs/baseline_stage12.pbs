#!/bin/bash

## =============================================================================
## PBS Resources
## =============================================================================

## Job name
#PBS -N as_stage12

## Project funding code
#PBS -P gs_ccds_wangwy

## Queue
#PBS -q gpu_as

## Stage 1 (5 domains x ~100 tasks x 8 rollouts + GLM annotation) and Stage 2 (SFT, 2 epochs)
#PBS -l walltime=48:00:00

## 1 node, 48 CPUs, 4 GPUs: four vLLM replicas for Stage 1, four SFT ranks for Stage 2
#PBS -l select=1:ncpus=24:ngpus=2

## Merge stderr into stdout
#PBS -j oe
#PBS -k oed

## PBS output directory
## NOTE: this directory must already exist before qsub.
#PBS -o /home/qingyuan.liu/projects/Evolve/SEED/.pbs_logs/


## Exit on unexpected errors and propagate pipeline errors.
##
## We intentionally DO NOT use `set -u`, because Conda activation scripts
## may reference unset variables.
set -eo pipefail


## =============================================================================
## Paths
## =============================================================================

WORKDIR="/home/qingyuan.liu/projects/Evolve/SEED"

cd "${WORKDIR}" || exit 1

export PYTHONUNBUFFERED=1

mkdir -p .pbs_logs
mkdir -p logs/agentstream

## Save the complete PBS wrapper output.
exec > >(tee -a ".pbs_logs/${PBS_JOBID}.run.log") 2>&1


## =============================================================================
## Debug Info
## =============================================================================

echo "======================================================================"
echo "PBS Job Information"
echo "======================================================================"
echo "Job ID        : ${PBS_JOBID}"
echo "Hostname      : $(hostname)"
echo "Working dir   : $(pwd)"
echo "Start time    : $(date)"
echo "CPUs (cgroup) : $(nproc)"
echo "======================================================================"

echo ""
echo "PBS_NODEFILE:"
cat "${PBS_NODEFILE}"

echo ""
echo "Initial CUDA_VISIBLE_DEVICES:"
echo "${CUDA_VISIBLE_DEVICES:-NOT_SET}"

echo ""
echo "nvidia-smi -L:"
nvidia-smi -L || {
    echo "ERROR: nvidia-smi failed."
    exit 1
}

echo ""


## =============================================================================
## Fix CUDA_VISIBLE_DEVICES
## =============================================================================
##
## PBS may expose GPUs using UUIDs (GPU-xxxx,...); vLLM / torchrun expect
## integer indices, so convert the list into contiguous indices.
##

if echo "${CUDA_VISIBLE_DEVICES:-}" | grep -q "GPU-"; then

    GPU_COUNT=$(echo "${CUDA_VISIBLE_DEVICES}" | tr ',' '\n' | wc -l)

    CUDA_VISIBLE_DEVICES=$(seq -s, 0 $((GPU_COUNT - 1)))

    export CUDA_VISIBLE_DEVICES

    echo "Converted CUDA_VISIBLE_DEVICES to integer indices:"
    echo "${CUDA_VISIBLE_DEVICES}"
fi

## Fallback if PBS does not set CUDA_VISIBLE_DEVICES.
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0,1,2,3}"

echo ""
echo "Final CUDA_VISIBLE_DEVICES:"
echo "${CUDA_VISIBLE_DEVICES}"


## =============================================================================
## GPU Monitor
## =============================================================================

GPU_MONITOR_LOG=".pbs_logs/${PBS_JOBID}.gpu.log"

(
    while true; do
        echo "=================================================================="
        echo "$(date)"
        echo "=================================================================="

        gpustat -cp || nvidia-smi

        echo ""
        sleep 300
    done
) > "${GPU_MONITOR_LOG}" 2>&1 &

GPU_MONITOR_PID=$!

## Stop GPU monitor when PBS script exits.
trap 'kill "${GPU_MONITOR_PID}" 2>/dev/null || true' EXIT

echo ""
echo "GPU monitor log:"
echo "${GPU_MONITOR_LOG}"


## =============================================================================
## Prepare Conda Environment
## =============================================================================
##
## Do NOT use `module load anaconda/2025`: on this cluster it pulls in system CUDA 13.1.
##

eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"

conda activate seed-as

echo ""
echo "======================================================================"
echo "Environment Information"
echo "======================================================================"

echo "CONDA_PREFIX : ${CONDA_PREFIX}"
echo "Python       : $(which python)"
echo "Python ver   : $(python --version)"
echo "CUDA_HOME    : ${CUDA_HOME:-NOT_SET}"
echo "NVCC         : $(which nvcc || true)"

echo ""
echo "nvcc version:"
nvcc --version || true

echo ""


## =============================================================================
## PyTorch / GPU Sanity Check
## =============================================================================

python - <<'PY'
import torch

print("PyTorch       :", torch.__version__)
print("Torch CUDA    :", torch.version.cuda)
print("CUDA usable   :", torch.cuda.is_available())
print("GPU count     :", torch.cuda.device_count())

for i in range(torch.cuda.device_count()):
    print(f"GPU {i}         :", torch.cuda.get_device_name(i))

if not torch.cuda.is_available():
    raise RuntimeError("CUDA is not available.")

if torch.cuda.device_count() != 2:
    raise RuntimeError(
        f"Expected 4 GPUs, but PyTorch sees {torch.cuda.device_count()}."
    )
PY


## =============================================================================
## Stage 1 (hindsight-skill SFT data) + Stage 2 (SFT training and export)
## =============================================================================
##
## run_stage12.sh pins Stage 1/2 to GPUs 0-3 regardless of .env, starts the
## BrowseComp retriever on CPU, checks the Stage-1 metrics before Stage 2 and
## exports the SFT checkpoint every Stage-3 run starts from.
## Use `prepare` or `sft` instead of `all` to run one stage only.
export STAGE12_NGPUS=2

AGENTSTREAM_BASE_MODEL_NAME=Qwen2.5-7B-Instruct \
    bash examples/agentstream_trainer/run_stage12.sh sft
