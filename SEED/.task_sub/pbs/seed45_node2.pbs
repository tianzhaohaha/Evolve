#!/bin/bash

## =============================================================================
## PBS Resources
## =============================================================================

## Job name
#PBS -N s45_node2

## Project funding code
#PBS -P gs_ccds_wangwy

## Queue
#PBS -q gpu_as

## Maximum walltime for the ENTIRE job
#PBS -l walltime=72:00:00

## 1 node, 24 CPUs, 2 GPUs
#PBS -l select=1:ncpus=48:ngpus=2

## Merge stderr into stdout
#PBS -j oe
#PBS -k oed

## PBS output directory
## NOTE: this directory must already exist before qsub.
#PBS -o /home/qingyuan.liu/projects/Evolve/SEED/.pbs_logs/


## Exit on unexpected errors and propagate pipeline errors.
##
## We intentionally DO NOT use `set -u`, because Conda activation scripts
## may reference unset variables.
set -eo pipefail


## =============================================================================
## Paths
## =============================================================================

WORKDIR="/home/qingyuan.liu/projects/Evolve/SEED"

cd "${WORKDIR}" || exit 1

export PYTHONUNBUFFERED=1

mkdir -p .pbs_logs
mkdir -p logs/agentstream

## Save the complete PBS wrapper output.
exec > >(tee -a ".pbs_logs/${PBS_JOBID}.run.log") 2>&1


## =============================================================================
## Debug Info
## =============================================================================

echo "======================================================================"
echo "PBS Job Information"
echo "======================================================================"
echo "Job ID        : ${PBS_JOBID}"
echo "Hostname      : $(hostname)"
echo "Working dir   : $(pwd)"
echo "Start time    : $(date)"
echo "======================================================================"

echo ""
echo "PBS_NODEFILE:"
cat "${PBS_NODEFILE}"

echo ""
echo "Initial CUDA_VISIBLE_DEVICES:"
echo "${CUDA_VISIBLE_DEVICES:-NOT_SET}"

echo ""
echo "nvidia-smi -L:"
nvidia-smi -L || {
    echo "ERROR: nvidia-smi failed."
    exit 1
}

echo ""


## =============================================================================
## Fix CUDA_VISIBLE_DEVICES
## =============================================================================
##
## PBS may expose GPUs using UUIDs:
##
##   GPU-xxxx,GPU-yyyy
##
## Some of our training / torchrun code expects integer indices:
##
##   0,1
##
## Therefore convert the PBS-provided UUID list into contiguous indices.
##

if echo "${CUDA_VISIBLE_DEVICES:-}" | grep -q "GPU-"; then

    GPU_COUNT=$(echo "${CUDA_VISIBLE_DEVICES}" | tr ',' '\n' | wc -l)

    CUDA_VISIBLE_DEVICES=$(seq -s, 0 $((GPU_COUNT - 1)))

    export CUDA_VISIBLE_DEVICES

    echo "Converted CUDA_VISIBLE_DEVICES to integer indices:"
    echo "${CUDA_VISIBLE_DEVICES}"
fi

## Fallback if PBS does not set CUDA_VISIBLE_DEVICES.
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0,1}"

echo ""
echo "Final CUDA_VISIBLE_DEVICES:"
echo "${CUDA_VISIBLE_DEVICES}"


## =============================================================================
## GPU Monitor
## =============================================================================

GPU_MONITOR_LOG=".pbs_logs/${PBS_JOBID}.gpu.log"

(
    while true; do
        echo "=================================================================="
        echo "$(date)"
        echo "=================================================================="

        gpustat -cp || nvidia-smi

        echo ""
        sleep 300
    done
) > "${GPU_MONITOR_LOG}" 2>&1 &

GPU_MONITOR_PID=$!

## Stop GPU monitor when PBS script exits.
trap 'kill "${GPU_MONITOR_PID}" 2>/dev/null || true' EXIT

echo ""
echo "GPU monitor log:"
echo "${GPU_MONITOR_LOG}"


## =============================================================================
## Prepare Conda Environment
## =============================================================================
##
## Do NOT use:
##
##   module load anaconda/2025
##
## because on this cluster it pulled in system CUDA 13.1.
##

eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"

conda activate seed-as

echo ""
echo "======================================================================"
echo "Environment Information"
echo "======================================================================"

echo "CONDA_PREFIX : ${CONDA_PREFIX}"
echo "Python       : $(which python)"
echo "Python ver   : $(python --version)"
echo "CUDA_HOME    : ${CUDA_HOME:-NOT_SET}"
echo "NVCC         : $(which nvcc || true)"

echo ""
echo "nvcc version:"
nvcc --version || true

echo ""


## =============================================================================
## PyTorch / GPU Sanity Check
## =============================================================================

python - <<'PY'
import torch

print("PyTorch       :", torch.__version__)
print("Torch CUDA    :", torch.version.cuda)
print("CUDA usable   :", torch.cuda.is_available())
print("GPU count     :", torch.cuda.device_count())

for i in range(torch.cuda.device_count()):
    print(f"GPU {i}         :", torch.cuda.get_device_name(i))

if not torch.cuda.is_available():
    raise RuntimeError("CUDA is not available.")

if torch.cuda.device_count() != 2:
    raise RuntimeError(
        f"Expected 2 GPUs, but PyTorch sees {torch.cuda.device_count()}."
    )
PY


## =============================================================================
## Stage-3 Experiments: stream seed 45, node 2
## =============================================================================
##
## ROUND=1 is the first submission (grpo_base, ~58 h). When it has finished, resubmit this file with
##   qsub -v ROUND=2 ...   (or edit ROUND below)   for the remaining runs (opsd_base + rlsd_base on 7B isolated, ~38 h; a shorter walltime is enough).
## Nothing is checkpointed, so a run killed by the walltime restarts from scratch: keep each round
## well inside the walltime. Hours are estimates from the suites' timings (4B: 31 min/step).
## Runs: baselines via run_baseline_suite.sh (*_base: raw backbone; seed: the shared SFT checkpoint).

## New stream seed: changes the domain order / interleaving only (task set and holdout stay fixed).
## Do not use 42 (no reshuffle). 44 = the earlier runs.
export AGENTSTREAM_STREAM_SEED=45
## Holdout validation every 10 steps; the last step is always validated (a 7-step isolated run only at step 7).
export AGENTSTREAM_RL_TEST_FREQ=10
ROUND="${ROUND:-1}"

BASE=examples/agentstream_trainer/run_baseline_suite.sh
M4=Qwen3-4B-Instruct-2507
M7=Qwen2.5-7B-Instruct

failed=0
run() { "$@" || { echo "[FAILED] $*"; failed=1; }; }   # a failed run does not stop the next one

case "$ROUND" in
1)
    run env AGENTSTREAM_BASE_MODEL_NAME=$M4 STREAM_MODE=interleaved BASELINES=grpo_base bash $BASE   # 4B interleaved (~10 h)
    run env AGENTSTREAM_BASE_MODEL_NAME=$M4 STREAM_MODE=isolated BASELINES=grpo_base bash $BASE   # 4B isolated (~11 h)
    run env AGENTSTREAM_BASE_MODEL_NAME=$M7 STREAM_MODE=interleaved BASELINES=grpo_base bash $BASE   # 7B interleaved (~18 h)
    run env AGENTSTREAM_BASE_MODEL_NAME=$M7 STREAM_MODE=isolated BASELINES=grpo_base bash $BASE   # 7B isolated (~19 h)
    ;;
2)
    run env AGENTSTREAM_BASE_MODEL_NAME=$M7 STREAM_MODE=isolated BASELINES=opsd_base,rlsd_base bash $BASE   # 7B isolated (~19 h each)
    ;;
*)
    echo "ROUND must be 1 or 2, got '$ROUND'"; exit 2 ;;
esac

exit "$failed"
